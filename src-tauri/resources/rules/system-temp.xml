<?xml version="1.0" encoding="UTF-8"?>
<ruleset id="system-temp" version="1" lang="zh-CN">
  <category id="temp.user" label="用户临时文件" risk="green" disposition="direct"
            description="程序临时文件，删除后自动重建">
    <target type="env" value="%TEMP%"/>
    <include pattern="*" recursive="true" maxAgeDays="7"/>
    <exclude pattern="*.lock"/>
    <guard process=""/>
  </category>
  <category id="temp.system" label="系统临时目录" risk="green" disposition="direct"
            description="Windows 系统临时目录（%SystemRoot%\Temp）中的过期文件，删除后由系统/程序自动重建">
    <target type="env" value="%SystemRoot%\Temp"/>
    <include pattern="*" recursive="true" maxAgeDays="3"/>
    <exclude pattern="*.tmp.lock"/>
    <guard process=""/>
  </category>
  <category id="temp.thumb" label="缩略图缓存" risk="green" disposition="direct"
            description="资源管理器缩略图/图标缓存数据库，删除后自动重建">
    <target type="knownFolder" value="Thumbnail Cache"/>
    <!-- R32-0：收紧为缓存数据库文件本身。原 `*` 递归会清空整个 Explorer 目录
         （含 ExplorerStartupLog*.etl 等非缓存文件），真机审计中发现。 -->
    <include pattern="thumbcache_*.db" recursive="false"/>
    <include pattern="iconcache_*.db" recursive="false"/>
    <guard process=""/>
  </category>
</ruleset>